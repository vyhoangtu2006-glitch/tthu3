@model IEnumerable<NguoiThue>

@{
    ViewData["Title"] = "Người thuê";
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="p-8 bg-gray-50 min-h-screen">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Người thuê</h1>
        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
        {
            <a asp-controller="NguoiThue" asp-action="Create" class="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700">+ Thêm Người Thuê</a>
        }
    </div>

    <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <table class="min-w-full">
            <thead class="bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <tr>
                    <th class="px-4 py-3">Họ tên</th>
                    <th class="px-4 py-3">SĐT</th>
                    <th class="px-4 py-3">CCCD</th>
                    <th class="px-4 py-3">Địa chỉ</th>
                    <th class="px-4 py-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr><td class="px-4 py-4 text-sm text-gray-500" colspan="5">Không có người thuê.</td></tr>
                }
                else
                {
                    foreach (var t in Model)
                    {
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-4 py-4">@t.HoTen</td>
                            <td class="px-4 py-4">@t.SoDienThoai</td>
                            <td class="px-4 py-4">@t.CCCD</td>
                            <td class="px-4 py-4">@t.DiaChi</td>
                            <td class="px-4 py-4">
                                <div class="flex items-center space-x-3">
                                    <a asp-controller="NguoiThue" asp-action="Details" asp-route-id="@t.CCCD" class="text-gray-700 hover:text-gray-900">Xem</a>
                                    <a asp-controller="HopDong" asp-action="Index" asp-route-tenant="@t.CCCD" class="text-blue-600 hover:underline">Hợp đồng</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>