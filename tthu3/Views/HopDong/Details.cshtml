@model tthu3.Models.HopDongViewModel

@{
    ViewData["Title"] = "Chi tiết Hợp đồng";
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="p-8 bg-gray-50 min-h-screen">
    <div class="max-w-2xl mx-auto bg-white p-6 rounded shadow">
        <h2 class="text-2xl font-semibold mb-4">Chi tiết hợp đồng @Model.HopDong.MaHopDong</h2>

        <dl class="grid grid-cols-1 gap-3">
            <div><span class="font-semibold">Mã hợp đồng:</span> @Model.HopDong.MaHopDong</div>
            <div><span class="font-semibold">Mã phòng:</span> @Model.HopDong.MaPhong</div>
            <div><span class="font-semibold">Họ và tên người thuê:</span> @Model.TenantName</div>
            <div><span class="font-semibold">Số điện thoại:</span> @Model.TenantPhone</div>
            <div><span class="font-semibold">CCCD:</span> @Model.HopDong.TenantCCCD</div>
            <div><span class="font-semibold">Ngày bắt đầu:</span> @Model.HopDong.NgayBatDau.ToString("yyyy-MM-dd")</div>
            <div><span class="font-semibold">Ngày kết thúc:</span> @(Model.HopDong.NgayKetThuc?.ToString("yyyy-MM-dd") ?? "-")</div>
            <div><span class="font-semibold">Giá thuê/tháng:</span> @Model.HopDong.GiaThueThang.ToString("N0")</div>
            <div><span class="font-semibold">Tiền cọc:</span> @Model.HopDong.TienCoc.ToString("N0")</div>
            <div><span class="font-semibold">Trạng thái:</span> @Model.HopDong.TrangThai</div>
        </dl>

        <div class="mt-4">
            <a asp-action="Index" class="px-4 py-2 rounded border text-gray-700">Quay về</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.HopDong.MaHopDong" class="ml-2 px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700">Sửa</a>
            }
        </div>
    </div>
</div>