@model IEnumerable<PhongTro>

@{
    ViewData["Title"] = "Quản lý Phòng Trọ";
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-4xl font-bold text-gray-800 tracking-tight">FEATURED PROPERTIES</h1>
                <div class="mt-2 text-sm text-gray-500">Featured for rent / Featured for sale</div>
            </div>

            <div>
                <a href="#" class="inline-block px-4 py-2 rounded border border-purple-700 text-purple-700 hover:bg-purple-700 hover:text-white transition">Show More Property</a>
            </div>
        </div>

        <!-- Cards grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @if (Model == null || !Model.Any())
            {
                <div class="col-span-full bg-white p-6 rounded shadow text-gray-500">Không có phòng nào.</div>
            }
            else
            {
                foreach (var p in Model)
                {
                    <div class="bg-white rounded shadow overflow-hidden">
                        <div class="relative">
                            <div class="h-44 bg-gray-200 bg-center bg-cover" style="background-image: url('/images/room-placeholder.jpg');"></div>
                        </div>

                        <div class="p-5">
                            <div class="flex items-baseline justify-between">
                                <div>
                                    <div class="text-lg font-semibold text-purple-700">@p.GiaPhong.ToString("N0") VNĐ</div>
                                    <div class="mt-1 text-sm text-gray-500">Asking Price</div>
                                </div>
                                <div class="text-right text-sm text-gray-500">@p.DienTich m²</div>
                            </div>

                            <h3 class="mt-4 text-xl font-bold text-gray-800">@p.TenPhong</h3>

                            <div class="mt-3 text-sm text-gray-500">
                                <div class="flex items-center space-x-3">
                                    <div class="flex items-center space-x-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M7 7v8a4 4 0 004 4h2a4 4 0 004-4V7"/></svg>
                                        <span>@(p.DaChoThue ? "Đã thuê" : "Còn trống")</span>
                                    </div>
                                    <div class="text-xs text-gray-400">•</div>
                                    <div>@p.MaPhong</div>
                                </div>
                            </div>

                            <div class="mt-4 flex items-center justify-between">
                                <div class="flex items-center space-x-3 text-sm">
                                    <a asp-action="Details" asp-route-id="@p.MaPhong" asp-controller="PhongTro" class="text-gray-700 hover:underline">Xem</a>

                                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@p.MaPhong" asp-controller="PhongTro" class="text-blue-600 hover:underline">Sửa</a>
                                        <form asp-action="Delete" asp-controller="PhongTro" method="post" class="inline" onsubmit="return confirm('Bạn có chắc muốn xóa phòng @p.MaPhong không?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.MaPhong" />
                                            <button type="submit" class="text-red-600 hover:underline bg-transparent border-0 p-0">Xóa</button>
                                        </form>
                                    }
                                </div>

                                <div class="text-sm text-gray-400">@* placeholder for meta *@</div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>