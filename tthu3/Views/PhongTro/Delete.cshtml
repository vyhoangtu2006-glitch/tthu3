@model PhongTro

@{
    ViewData["Title"] = "Xóa Phòng";
}

<div class="p-8 bg-gray-50 min-h-screen">
    <div class="max-w-2xl mx-auto bg-white p-6 rounded shadow">
        <h2 class="text-2xl font-semibold mb-4">Xác nhận xóa phòng</h2>

        <dl class="grid grid-cols-1 gap-2">
            <div><span class="font-semibold">Mã phòng:</span> @Model.MaPhong</div>
            <div><span class="font-semibold">Tên phòng:</span> @Model.TenPhong</div>
            <div><span class="font-semibold">Giá:</span> @Model.GiaPhong.ToString("N0")</div>
            <div><span class="font-semibold">Diện tích:</span> @Model.DienTich m²</div>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaPhong" />
            <div class="flex space-x-2">
                <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">Xóa</button>
                <a asp-action="Index" class="px-4 py-2 rounded border text-gray-700">Hủy</a>
            </div>
        </form>
    </div>
</div>

